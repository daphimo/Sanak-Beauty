<section class="wishlist-page page-width" data-wishlist-page>
  <header class="wishlist-page__header">
    <p class="wishlist-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <div class="rte">{{ section.settings.text }}</div>
  </header>
  <div class="wishlist-page__status" data-wishlist-status aria-live="polite">Loading your wishlist…</div>
  <div class="wishlist-page__grid" data-wishlist-grid></div>
  <template data-wishlist-card>
    <article class="wishlist-card">
      <a class="wishlist-card__media" data-product-link><img data-product-image alt="" loading="lazy" width="700" height="875"></a>
      <button class="sanak-wishlist-button" type="button" data-wishlist-toggle aria-pressed="true">{% render 'icons', icon: 'heart' %}</button>
      <div class="wishlist-card__content"><h2><a data-product-link data-product-title></a></h2><p data-product-price></p><a class="button button--primary" data-product-link>View product {% render 'icons', icon: 'arrow' %}</a></div>
    </article>
  </template>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-wishlist-page]');
    if (!root) return;
    const key = 'sanak:wishlist:v1';
    const money = (cents, currency) => new Intl.NumberFormat(document.documentElement.lang || 'en', { style: 'currency', currency }).format(cents / 100);
    const render = async () => {
      const handles = JSON.parse(localStorage.getItem(key) || '[]');
      const grid = root.querySelector('[data-wishlist-grid]');
      const status = root.querySelector('[data-wishlist-status]');
      grid.replaceChildren();
      if (!handles.length) { status.textContent = {{ section.settings.empty_text | json }}; return; }
      status.textContent = '';
      const products = await Promise.all(handles.map((handle) => fetch(`${window.Shopify.routes.root}products/${encodeURIComponent(handle)}.js`).then((response) => response.ok ? response.json() : null)));
      products.filter(Boolean).forEach((product) => {
        const card = root.querySelector('[data-wishlist-card]').content.cloneNode(true);
        card.querySelectorAll('[data-product-link]').forEach((link) => { link.href = product.url; });
        card.querySelector('[data-product-title]').textContent = product.title;
        card.querySelector('[data-product-price]').textContent = money(product.price, product.currency || {{ cart.currency.iso_code | json }});
        const image = card.querySelector('[data-product-image]');
        image.src = product.featured_image || '';
        image.alt = product.title;
        const button = card.querySelector('[data-wishlist-toggle]');
        button.dataset.productHandle = product.handle;
        button.dataset.productTitle = product.title;
        grid.append(card);
      });
    };
    render().catch(() => { root.querySelector('[data-wishlist-status]').textContent = 'Your wishlist could not be loaded.'; });
    window.addEventListener('sanak:wishlist-change', render);
  })();
</script>

{% stylesheet %}
.wishlist-page{padding-top:clamp(6rem,9vw,12rem);padding-bottom:clamp(8rem,12vw,16rem)}.wishlist-page__header{max-width:75rem;margin-bottom:5rem}.wishlist-page__eyebrow{text-transform:uppercase;letter-spacing:.16em}.wishlist-page h1{margin:.5rem 0;font-size:clamp(5rem,9vw,11rem)}.wishlist-page__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem}.wishlist-card{position:relative}.wishlist-card__media{display:block;aspect-ratio:4/5;overflow:hidden;background:var(--sanak-grey)}.wishlist-card__media img{width:100%;height:100%;object-fit:cover;transition:transform .7s var(--sanak-ease)}.wishlist-card:hover img{transform:scale(1.035)}.wishlist-card__content{padding:1.8rem 0}.wishlist-card__content h2{font-size:2.4rem}.wishlist-card__content .button{width:100%;margin-top:1rem}@media(max-width:989px){.wishlist-page__grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:549px){.wishlist-page__grid{grid-template-columns:1fr}}
{% endstylesheet %}

{% schema %}
{"name":"Wishlist page","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Saved for later"},{"type":"text","id":"heading","label":"Heading","default":"Your wishlist"},{"type":"richtext","id":"text","label":"Introduction","default":"<p>Your edit of colour, texture and expression—kept in this browser.</p>"},{"type":"text","id":"empty_text","label":"Empty wishlist message","default":"Your wishlist is waiting. Explore the collection and tap the heart to save a product."}]}
{% endschema %}
