{{ 'mobile-dock.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mobile-dock.js' | asset_url }}" defer="defer"></script>

<nav class="sanak-mobile-dock" data-mobile-dock aria-label="{{ section.settings.accessibility_label | escape }}">
  <button type="button" class="sanak-mobile-dock__item" data-dock-menu aria-label="{{ 'sections.header.menu' | t }}">
    <span class="sanak-mobile-dock__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M3 4H21V6H3V4ZM3 11H21V13H3V11ZM3 18H21V20H3V18Z"></path></svg></span>
    <span class="sanak-mobile-dock__label">{{ section.settings.menu_label | escape }}</span>
  </button>
  <a class="sanak-mobile-dock__item{% if request.path contains '/collections' %} is-active{% endif %}" href="{{ routes.collections_url }}" aria-label="{{ section.settings.shop_label | escape }}"{% if request.path contains '/collections' %} aria-current="page"{% endif %}>
    <span class="sanak-mobile-dock__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M21 13.2422V20H22V22H2V20H3V13.2422C1.79401 12.435 1 11.0602 1 9.5C1 8.67286 1.22443 7.87621 1.63322 7.19746L4.3453 2.5C4.52393 2.1906 4.85406 2 5.21132 2H18.7887C19.1459 2 19.4761 2.1906 19.6547 2.5L22.3575 7.18172C22.7756 7.87621 23 8.67286 23 9.5C23 11.0602 22.206 12.435 21 13.2422ZM19 13.9725C18.8358 13.9907 18.669 14 18.5 14C17.2409 14 16.0789 13.478 15.25 12.6132C14.4211 13.478 13.2591 14 12 14C10.7409 14 9.5789 13.478 8.75 12.6132C7.9211 13.478 6.75911 14 5.5 14C5.331 14 5.16417 13.9907 5 13.9725V20H19V13.9725ZM5.78865 4L3.35598 8.21321C3.12409 8.59843 3 9.0389 3 9.5C3 10.8807 4.11929 12 5.5 12C6.53096 12 7.44467 11.3703 7.82179 10.4295C8.1574 9.59223 9.3426 9.59223 9.67821 10.4295C10.0553 11.3703 10.969 12 12 12C13.031 12 13.9447 11.3703 14.3218 10.4295C14.6574 9.59223 15.8426 9.59223 16.1782 10.4295C16.5553 11.3703 17.469 12 18.5 12C19.8807 12 21 10.8807 21 9.5C21 9.0389 20.8759 8.59843 20.6347 8.19746L18.2113 4H5.78865Z"></path></svg></span>
    <span class="sanak-mobile-dock__label">{{ section.settings.shop_label | escape }}</span>
  </a>
  {% comment %} <button type="button" class="sanak-mobile-dock__item" data-dock-videos aria-label="{{ section.settings.video_label | escape }}">
    <span class="sanak-mobile-dock__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M17 9.2L22.2133 5.55071C22.4395 5.39235 22.7513 5.44737 22.9096 5.6736C22.9684 5.75764 23 5.85774 23 5.96033V18.0397C23 18.3158 22.7761 18.5397 22.5 18.5397C22.3974 18.5397 22.2973 18.5081 22.2133 18.4493L17 14.8V19C17 19.5523 16.5523 20 16 20H2C1.44772 20 1 19.5523 1 19V5C1 4.44772 1.44772 4 2 4H16C16.5523 4 17 4.44772 17 5V9.2ZM17 12.3587L21 15.1587V8.84131L17 11.6413V12.3587ZM3 6V18H15V6H3Z"></path></svg></span>
    <span class="sanak-mobile-dock__label">{{ section.settings.video_label | escape }}</span>
  </button> {% endcomment %}
  <a class="sanak-mobile-dock__item{% if request.path contains '/pages/wishlist' %} is-active{% endif %}" href="{{ routes.root_url }}pages/wishlist" aria-label="{{ section.settings.wishlist_label | escape }}"{% if request.path contains '/pages/wishlist' %} aria-current="page"{% endif %}>
    <span class="sanak-mobile-dock__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M12 8.81056L13.6352 6.48845C14.2721 5.58412 15.3179 5 16.5 5C18.433 5 20 6.567 20 8.5C20 11.3788 18.0407 14.1215 15.643 16.3358C14.4877 17.4027 13.3237 18.2603 12.4451 18.8521C12.2861 18.9592 12.1371 19.0571 11.9999 19.1456C11.8627 19.0571 11.7137 18.9592 11.5547 18.8521C10.6761 18.2604 9.51216 17.4028 8.35685 16.3358C5.95926 14.1216 4 11.3788 4 8.5C4 6.567 5.567 5 7.5 5C8.68209 5 9.72794 5.58412 10.3648 6.48845L12 8.81056ZM10.5557 3.92626C9.68172 3.3412 8.63071 3 7.5 3C4.46243 3 2 5.46243 2 8.5C2 16 11.9999 21.4852 11.9999 21.4852C11.9999 21.4852 22 16 22 8.5C22 5.46243 19.5376 3 16.5 3C15.3693 3 14.3183 3.3412 13.4443 3.92626C12.8805 4.3037 12.3903 4.78263 12 5.33692C11.6097 4.78263 11.1195 4.3037 10.5557 3.92626Z"></path></svg><span class="sanak-mobile-dock__count" data-wishlist-count data-count="0"></span></span>
    <span class="sanak-mobile-dock__label">{{ section.settings.wishlist_label | escape }}</span>
  </a>
  <button type="button" class="sanak-mobile-dock__item" data-dock-cart aria-label="{{ 'templates.cart.cart' | t }}" aria-haspopup="dialog">
    <span class="sanak-mobile-dock__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M4.00488 16V4H2.00488V2H5.00488C5.55717 2 6.00488 2.44772 6.00488 3V15H18.4433L20.4433 7H8.00488V5H21.7241C22.2764 5 22.7241 5.44772 22.7241 6C22.7241 6.08176 22.7141 6.16322 22.6942 6.24254L20.1942 16.2425C20.083 16.6877 19.683 17 19.2241 17H5.00488C4.4526 17 4.00488 16.5523 4.00488 16ZM6.00488 23C4.90031 23 4.00488 22.1046 4.00488 21C4.00488 19.8954 4.90031 19 6.00488 19C7.10945 19 8.00488 19.8954 8.00488 21C8.00488 22.1046 7.10945 23 6.00488 23ZM18.0049 23C16.9003 23 16.0049 22.1046 16.0049 21C16.0049 19.8954 16.9003 19 18.0049 19C19.1095 19 20.0049 19.8954 20.0049 21C20.0049 22.1046 19.1095 23 18.0049 23Z"></path></svg>{% if cart != empty %}<span class="sanak-mobile-dock__count">{{ cart.item_count }}</span>{% endif %}</span>
    <span class="sanak-mobile-dock__label">{{ section.settings.cart_label | escape }}</span>
  </button>
</nav>

{% schema %}
{
  "name": "Sanak mobile dock",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Mobile navigation" },
    { "type": "text", "id": "menu_label", "label": "Menu label", "default": "Menu" },
    { "type": "text", "id": "shop_label", "label": "Shop label", "default": "Shop" },
    { "type": "text", "id": "video_label", "label": "Video label", "default": "Videos" },
    { "type": "text", "id": "wishlist_label", "label": "Wishlist label", "default": "Wishlist" },
    { "type": "text", "id": "cart_label", "label": "Cart label", "default": "Cart" }
  ],
  "presets": [{ "name": "Sanak mobile dock" }]
}
{% endschema %}
