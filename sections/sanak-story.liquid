<section class="sanak-story color-{{ section.settings.color_scheme }}">
  <div class="page-width sanak-story__grid">
    <div class="sanak-story__copy">
      <p class="sanak-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.link_label != blank -%}<a class="link underlined-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} {% render 'icons', icon: 'arrow' %}</a>{%- endif -%}
    </div>
    <div class="sanak-story__art" aria-label="Sanak Beauty editorial imagery">
      {%- for i in (1..3) -%}
        {%- assign setting_id = 'image_' | append: i -%}
        {%- assign story_image = section.settings[setting_id] -%}
        <figure class="sanak-story__image sanak-story__image--{{ i }}">
          {%- if story_image != blank -%}
            {{ story_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '320, 540, 750, 1000' }}
          {%- else -%}
            <img src="{{ 'sanak-editorial-' | append: i | append: '.jpg' | asset_url }}" alt="Sanak Beauty editorial portrait {{ i }}" loading="lazy" width="900" height="1200">
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.sanak-story{padding:clamp(7rem,10vw,14rem) 0;background:var(--sanak-green);color:var(--sanak-ivory)}.sanak-story__grid{display:grid;grid-template-columns:minmax(28rem,.72fr) 1.3fr;gap:clamp(5rem,10vw,15rem);align-items:center}.sanak-story__copy{position:sticky;top:14rem}.sanak-story h2{margin:.8rem 0 2rem;color:inherit;font-size:clamp(5rem,7vw,10rem);line-height:.9}.sanak-story__eyebrow{text-transform:uppercase;letter-spacing:.18em}.sanak-story .link{display:inline-flex;gap:1rem;align-items:center;margin-top:2rem;color:inherit}.sanak-story__art{display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:start}.sanak-story__image{margin:0;overflow:hidden}.sanak-story__image img{display:block;width:100%;height:auto;transition:transform 1s var(--sanak-ease)}.sanak-story__image:hover img{transform:scale(1.04)}.sanak-story__image--2{margin-top:10rem}.sanak-story__image--3{grid-column:1/-1;width:66%;margin:-2rem auto 0}@media(max-width:749px){.sanak-story__grid{grid-template-columns:1fr}.sanak-story__copy{position:static}.sanak-story__art{gap:1rem}.sanak-story__image--2{margin-top:5rem}.sanak-story__image--3{width:75%}}
{% endstylesheet %}

{% schema %}
{"name":"Sanak brand story","tag":"section","class":"section","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"From the soul"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Beauty is an art form."},{"type":"richtext","id":"text","label":"Text","default":"<p>We make expressive, high-performance colour for skin that deserves to be seen in its full depth.</p>"},{"type":"text","id":"link_label","label":"Link label","default":"Our story"},{"type":"url","id":"link","label":"Link"},{"type":"image_picker","id":"image_1","label":"Image 1"},{"type":"image_picker","id":"image_2","label":"Image 2"},{"type":"image_picker","id":"image_3","label":"Image 3"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-3"}],"presets":[{"name":"Sanak brand story"}]}
{% endschema %}
