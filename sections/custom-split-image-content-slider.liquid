{{ 'custom-buttons.css' | asset_url | stylesheet_tag }}
{{ 'custom-split-image-content-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-split-image-content-slider.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign slide_count = section.blocks.size
  assign has_multiple_slides = false
  if slide_count > 1
    assign has_multiple_slides = true
  endif
-%}

<section
  id="SplitSlider-{{ section.id }}"
  class="split-slider split-slider--desktop-{{ section.settings.desktop_height_mode }} split-slider--mobile-{{ section.settings.mobile_height_mode }} split-slider--mobile-{{ section.settings.mobile_order }}"
  style="--split-image-width: {{ section.settings.image_width }}%; --split-desktop-height: {{ section.settings.desktop_height }}px; --split-mobile-height: {{ section.settings.mobile_height }}px; --split-border-width: {% if section.settings.show_border %}1px{% else %}0{% endif %};"
  data-split-slider
  data-splide-js="{{ 'splide.min.js' | asset_url }}"
  data-splide-css="{{ 'splide-core.min.css' | asset_url }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
  data-speed="{{ section.settings.transition_speed }}"
  data-behavior="{{ section.settings.end_behavior }}"
  data-arrows="{{ section.settings.show_arrows }}"
  data-pagination="{{ section.settings.show_pagination }}"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="split-slider__layout">
    <div class="split-slider__visual splide" data-split-slider-visual>
      <div class="splide__track split-slider__track">
        <ul class="splide__list split-slider__list" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign main_image = block.settings.image
              assign image_alt = main_image.alt | default: block.settings.title | strip_html
              assign loading = 'lazy'
              assign fetchpriority = 'auto'
              if forloop.first
                assign loading = 'eager'
                assign fetchpriority = 'high'
              endif
            -%}
            <li class="splide__slide split-slider__slide" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div class="split-slider__image-wrap" style="--image-position: {{ block.settings.image_position }}; --image-overlay: {{ block.settings.image_overlay_color }}; --image-overlay-opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};">
                {%- if main_image != blank -%}
                  <picture>
                    {%- if block.settings.mobile_image != blank -%}
                      <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 550 }} 550w, {{ block.settings.mobile_image | image_url: width: 750 }} 750w, {{ block.settings.mobile_image | image_url: width: 1100 }} 1100w">
                    {%- endif -%}
                    {{ main_image | image_url: width: 2000 | image_tag: widths: '550, 750, 1100, 1500, 2000', sizes: '(min-width: 750px) var(--split-image-width), 100vw', class: 'split-slider__image', loading: loading, fetchpriority: fetchpriority, alt: image_alt }}
                  </picture>
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'split-slider__placeholder placeholder-svg' }}
                {%- endif -%}
                {%- if block.settings.image_overlay -%}<span class="split-slider__image-overlay" aria-hidden="true"></span>{%- endif -%}
              </div>
            </li>
          {%- else -%}
            <li class="splide__slide split-slider__slide"><div class="split-slider__image-wrap">{{ 'lifestyle-1' | placeholder_svg_tag: 'split-slider__placeholder placeholder-svg' }}</div></li>
          {%- endfor -%}
        </ul>
      </div>
      {%- if has_multiple_slides and section.settings.show_arrows -%}
        <div class="splide__arrows split-slider__arrows">
          <button class="splide__arrow splide__arrow--prev split-slider__arrow" type="button" aria-label="Previous slide">{%- render 'icons', icon: 'arrow-left', class: 'split-slider__arrow-icon' -%}</button>
          <button class="splide__arrow splide__arrow--next split-slider__arrow" type="button" aria-label="Next slide">{%- render 'icons', icon: 'arrow-right', class: 'split-slider__arrow-icon' -%}</button>
        </div>
      {%- endif -%}
      {%- if has_multiple_slides and section.settings.show_pagination -%}<ul class="splide__pagination split-slider__pagination"></ul>{%- endif -%}
    </div>

    <div class="split-slider__content-panel" data-split-slider-content>
      {%- for block in section.blocks -%}
        {%- liquid
          assign background_image = block.settings.background_image
          assign mobile_background_image = block.settings.mobile_background_image | default: background_image
        -%}
        <article
          class="split-slider__content{% if forloop.first %} is-active{% endif %} split-slider__content--position-{{ block.settings.content_position }} split-slider__content--align-{{ block.settings.text_alignment }}"
          data-content-index="{{ forloop.index0 }}"
          style="--content-bg: {{ block.settings.background_color }}; --content-overlay: {{ block.settings.background_overlay_color }}; --content-overlay-opacity: {{ block.settings.background_overlay_opacity | divided_by: 100.0 }}; --eyebrow-color: {{ block.settings.eyebrow_color }}; --title-color: {{ block.settings.title_color }}; --body-color: {{ block.settings.description_color }}; --highlight-color: {{ block.settings.highlight_color }};{% if background_image != blank %} --content-bg-image: url('{{ background_image | image_url: width: 1600 }}');{% endif %}{% if mobile_background_image != blank %} --content-mobile-bg-image: url('{{ mobile_background_image | image_url: width: 1000 }}');{% endif %}"
          {% unless forloop.first %}hidden inert aria-hidden="true"{% endunless %}
        >
          <span class="split-slider__content-overlay" aria-hidden="true"></span>
          <div class="split-slider__content-inner">
            {%- if block.settings.eyebrow != blank -%}<p class="split-slider__eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
            {%- if block.settings.title != blank -%}<h2 class="split-slider__title">{{ block.settings.title }}</h2>{%- endif -%}
            {%- if block.settings.description != blank -%}<div class="split-slider__description rte">{{ block.settings.description | escape | newline_to_br }}</div>{%- endif -%}
            {%- if block.settings.show_cta -%}
              {%- render 'custom-button', label: block.settings.cta_label, link: block.settings.cta_link, variant: block.settings.cta_style, background: block.settings.cta_background, text_color: block.settings.cta_text_color, border_color: block.settings.cta_border_color, show_arrow: true, custom_class: 'split-slider__cta' -%}
            {%- endif -%}
          </div>
        </article>
      {%- else -%}
        <article class="split-slider__content is-active"><div class="split-slider__content-inner"><p class="split-slider__eyebrow">A LITTLE MORE YOU</p><h2 class="split-slider__title">Beauty that feels like you.</h2></div></article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Split image slider",
  "tag": "section",
  "class": "section",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Featured stories" },
    { "type": "range", "id": "image_width", "label": "Desktop image width", "min": 35, "max": 65, "step": 5, "unit": "%", "default": 50 },
    { "type": "checkbox", "id": "show_border", "label": "Show subtle border", "default": false },
    { "type": "select", "id": "desktop_height_mode", "label": "Desktop height", "options": [{ "value": "auto", "label": "Auto" }, { "value": "custom", "label": "Custom" }], "default": "custom" },
    { "type": "range", "id": "desktop_height", "label": "Desktop custom height", "min": 450, "max": 900, "step": 25, "unit": "px", "default": 650, "visible_if": "{{ section.settings.desktop_height_mode == 'custom' }}" },
    { "type": "select", "id": "mobile_height_mode", "label": "Mobile image height", "options": [{ "value": "auto", "label": "Auto" }, { "value": "custom", "label": "Custom" }], "default": "custom" },
    { "type": "range", "id": "mobile_height", "label": "Mobile custom image height", "min": 240, "max": 650, "step": 10, "unit": "px", "default": 420, "visible_if": "{{ section.settings.mobile_height_mode == 'custom' }}" },
    { "type": "select", "id": "mobile_order", "label": "Mobile panel order", "options": [{ "value": "image-first", "label": "Image first" }, { "value": "content-first", "label": "Content first" }], "default": "image-first" },
    { "type": "checkbox", "id": "autoplay", "label": "Enable autoplay", "default": false },
    { "type": "range", "id": "autoplay_interval", "label": "Autoplay interval", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5, "visible_if": "{{ section.settings.autoplay }}" },
    { "type": "range", "id": "transition_speed", "label": "Transition speed", "min": 300, "max": 1200, "step": 100, "unit": "ms", "default": 600 },
    { "type": "select", "id": "end_behavior", "label": "End behavior", "options": [{ "value": "loop", "label": "Loop" }, { "value": "rewind", "label": "Rewind" }], "default": "loop" },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    { "type": "checkbox", "id": "show_pagination", "label": "Show pagination", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "header", "content": "Main image" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "center center", "label": "Center" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }, { "value": "left center", "label": "Left" }, { "value": "right center", "label": "Right" }], "default": "center center" },
        { "type": "checkbox", "id": "image_overlay", "label": "Enable image overlay", "default": false },
        { "type": "color", "id": "image_overlay_color", "label": "Image overlay color", "default": "#202B26" },
        { "type": "range", "id": "image_overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 15 },
        { "type": "header", "content": "Content" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A LITTLE MORE YOU" },
        { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Beauty that feels like you." },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Discover thoughtfully chosen essentials designed to make every day feel special." },
        { "type": "select", "id": "content_position", "label": "Vertical position", "options": [{ "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" }], "default": "center" },
        { "type": "text_alignment", "id": "text_alignment", "label": "Text alignment", "default": "left" },
        { "type": "checkbox", "id": "show_cta", "label": "Show button", "default": true },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Explore the collection" },
        { "type": "url", "id": "cta_link", "label": "Button link" },
        { "type": "select", "id": "cta_style", "label": "Button style", "options": [{ "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "link", "label": "Link" }], "default": "primary" },
        { "type": "header", "content": "Content background" },
        { "type": "image_picker", "id": "background_image", "label": "Background image" },
        { "type": "image_picker", "id": "mobile_background_image", "label": "Mobile background image" },
        { "type": "color", "id": "background_color", "label": "Background color", "default": "#FAF7EF" },
        { "type": "color", "id": "background_overlay_color", "label": "Background overlay color", "default": "#FAF7EF" },
        { "type": "range", "id": "background_overlay_opacity", "label": "Background overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 70 },
        { "type": "header", "content": "Colors" },
        { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#174C45" },
        { "type": "color", "id": "title_color", "label": "Title", "default": "#202B26" },
        { "type": "color", "id": "description_color", "label": "Description", "default": "#202B26" },
        { "type": "color", "id": "highlight_color", "label": "Title highlight", "default": "#174C45" },
        { "type": "color", "id": "cta_background", "label": "Button background", "default": "#174C45" },
        { "type": "color", "id": "cta_text_color", "label": "Button text", "default": "#FAF7EF" },
        { "type": "color", "id": "cta_border_color", "label": "Button border", "default": "#174C45" }
      ]
    }
  ],
  "presets": [{ "name": "Split image slider", "blocks": [{ "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
