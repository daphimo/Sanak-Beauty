{% doc %}
  Renders any SVG icon stored in theme assets through one shared entry point.
  @param {string} icon - Asset basename without the icon- prefix or .svg suffix.
  @param {string} [class] - Additional wrapper class.
  @param {string} [label] - Accessible label; omitted icons are decorative.
  @example
  {% render 'icons', icon: 'heart', class: 'button__icon' %}
{% enddoc %}

{%- liquid
  case icon
    when 'arrow-right'
      assign icon_asset = 'icon-arrow.svg'
    when 'arrow-left'
      assign icon_asset = 'icon-arrow.svg'
    when 'cart-bag'
      assign icon_asset = 'icon-cart-bag.svg'
    else
      assign icon_asset = 'icon-' | append: icon | append: '.svg'
  endcase
  assign icon_class = 'sanak-icon'
  if icon == 'arrow-left'
    assign icon_class = icon_class | append: ' sanak-icon--arrow-left'
  endif
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}
<span
  class="{{ icon_class }}"
  {% if label != blank %}role="img" aria-label="{{ label | escape }}"{% else %}aria-hidden="true"{% endif %}
>
  {{- icon_asset | inline_asset_content -}}
</span>
